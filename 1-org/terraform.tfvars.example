# Copy to terraform.tfvars and fill in the real values. Do not commit terraform.tfvars.
prefix                = "demo"
organization_id       = "organizations/000000000000"
directory_customer_id = "REPLACE_ME"   # Cloud Identity customer id, e.g. C01abc234
domain                = "example.com"
region                = "us-west2"

groups = {
  platform_engineers = "platform-engineers@example.com"
  developers         = "developers@example.com"
}

business_units = {
  business-unit-0 = {
    display_name = "Business Unit 0"
    group        = "business-unit-0@example.com"
  }
}
